#!/bin/sh
# Print the path of the excalive command: $EXCALIVE_HOME, then a clone named
# excalive in any directory above this skill (a workspace's subrepo), then
# excalive on PATH, then the checkout the excalive plugin installs
# (/plugin install excalive --marketplace RafeSymonds/excalive).
here="$(dirname "$(readlink -f "$0")")"
[ -n "$EXCALIVE_HOME" ] && [ -x "$EXCALIVE_HOME/bin/excalive" ] && { echo "$EXCALIVE_HOME/bin/excalive"; exit 0; }
d="$here"
while [ "$d" != "/" ]; do
  [ -x "$d/excalive/bin/excalive" ] && { echo "$d/excalive/bin/excalive"; exit 0; }
  d="$(dirname "$d")"
done
command -v excalive 2>/dev/null && exit 0
p="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/marketplaces/excalive/bin/excalive"
[ -x "$p" ] && { echo "$p"; exit 0; }
echo "excalive not found: install the plugin (/plugin install excalive --marketplace RafeSymonds/excalive), or clone https://github.com/RafeSymonds/excalive and set EXCALIVE_HOME" >&2
exit 1
